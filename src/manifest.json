{
    "manifest_version":  3,
    "name":  "custom-js",
    "short_name":  "custom-js",
    "author":  "xcv58",
    "minimum_chrome_version":  "135",
    "icons":  {
                  "16":  "icon-16.png",
                  "19":  "icon-19.png",
                  "32":  "icon-32.png",
                  "38":  "icon-38.png",
                  "48":  "icon-48.png",
                  "128":  "icon-128.png"
              },
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_security_policy":  {
                                    "extension_pages":  "script-src \u0027self\u0027; object-src \u0027self\u0027"
                                },
    "permissions":  [
                        "storage",
                        "unlimitedStorage",
                        "tabs",
                        "userScripts"
                    ],
    "action":  {
                   "default_icon":  "icon-48.png",
                   "default_popup":  "popup.html",
                   "default_title":  "custom-js"
               },
    "host_permissions":  [
                             "http://*/*",
                             "https://*/*"
                         ],
    "key":  "",
    "content_scripts":  [
                            {
                                "run_at":  "document_idle",
                                "all_frames":  true,
                                "matches":  [
                                                "http://*/*",
                                                "https://*/*"
                                            ],
                                "js":  [
                                           "runner.js"
                                       ]
                            }
                        ]
}